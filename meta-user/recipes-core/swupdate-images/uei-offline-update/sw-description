software =
{
    version = "1.0";
    description = "UEI offline update: boot files and QSPI image";
    hardware-compatibility: [ "1.0" ];

    stable =
    {
        main =
        {
            files: (
                {
                    filename = "Image";
                    path = "/boot/Image";
                    type = "rawfile";
                },
                {
                    filename = "system-top-4ev.dtb";
                    path = "/boot/system-top-4ev.dtb";
                    type = "rawfile";
                },
                {
                    filename = "qspi_boot_31_DNR_4ev.bin";
                    path = "/tmp/QSPI_BOOT.BIN";
                    type = "rawfile";
                }
            );

            scripts: (
                {
                    filename = "postinstall.sh";
                    type = "shellscript";
                }
            );
        };
    };
}