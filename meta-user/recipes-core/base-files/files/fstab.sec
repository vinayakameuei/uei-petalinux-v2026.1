# UEI Security fstab

/dev/root    /                auto       defaults                                 1  1
proc         /proc            proc       defaults,nodev                           0  0
devpts       /dev/pts         devpts     mode=0620,ptmxmode=0666,gid=5,nodev      0  0
tmpfs        /dev/shm         tmpfs      defaults,noexec,nodev,nosuid,size=250M   0  0
tmpfs        /run             tmpfs      mode=0755,nodev,nosuid,strictatime       0  0
tmpfs        /var/volatile    tmpfs      defaults,nodev                           0  0
