#!/bin/sh

. /etc/init.d/functions

start()
{
    echo -n "Starting pdnaserver..."
    (pdnaserver &) && success || failure
    echo
}

stop()
{
    echo -n "Stopping pdnaserver..."
    kill -n 2 'pidof pdnaserver -o %PPID' && success || failure
    echo
}

restart()
{
    stop
    start
}

case "$1" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart|reload)
        restart
        ;;
    *)
        echo "Usage $0 {start|stop|restart}"
        exit 1
esac

exit $?
