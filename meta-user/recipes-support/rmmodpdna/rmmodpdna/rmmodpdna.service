[Unit]
Description=Stop pdnadev at shutdown/reboot
Before=shutdown.target reboot.target halt.target
Before=pdnaserver.service
Wants=pdnaserver.service

[Service]
Type=oneshot
ExecStart=/bin/true
RemainAfterExit=yes
ExecStop=/usr/sbin/modprobe -rv pdnadev pdnabus

[Install]
WantedBy=multi-user.target
