[Unit]
Description=UEIModbus Slave Server
Conflicts=ueiopc.service
After=rc-local.service

[Service]
Type=simple
RemainAfterExit=true
ExecStart=/usr/bin/modbusslave
ExecStop=/bin/kill -s INT $MAINPID
ExecReload=/bin/kill -s HUP $MAINPID
KillMode=process
KillSignal=SIGINT

[Install]
WantedBy=multi-user.target
