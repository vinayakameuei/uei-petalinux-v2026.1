#!/bin/sh -e
#
# rc.local
#
# This script is executed at the end of each multiuser runlevel.
# Make sure that the script will "exit 0" on success or any other
# value on error.
#
# In order to enable or disable this script just change the execution
# bits.
#
# By default this script does nothing.


# Just start inetd directly without systemd
if [ -f /etc/init.d/busybox-inetd ]; then
    #chmod +x /etc/init.d/busybox-inetd
    /etc/init.d/busybox-inetd start
fi

if [ -f /etc/init.d/busybox-httpd ]; then
    #chmod +x /etc/init.d/busybox-httpd
    /etc/init.d/busybox-httpd start
fi

if [ -L /home/root/setguitrust.sh ]; then
    /home/root/setguitrust.sh
fi

# modprobe pdnadev
listlayers > /etc/layers.xml
sync
devtbl

exit 0