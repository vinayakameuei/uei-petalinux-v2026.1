From 7e959403c952b0e3024482358648dbe1d6b827e9 Mon Sep 17 00:00:00 2001
From: "UEI 6.18 port" <vinayak.kulkarni@ametek.com>
Date: Thu, 29 Oct 2026 17:14:41 +0530
Subject: [PATCH] updated defconfig with rtc pdna and ntl
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Signed-off-by: Vinayak <“vinayak.kulkarni@ametek.com”>
---
 arch/arm64/configs/xilinx_defconfig | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/arch/arm64/configs/xilinx_defconfig b/arch/arm64/configs/xilinx_defconfig
index 3d13b9c1497e..31c653af2219 100644
--- a/arch/arm64/configs/xilinx_defconfig
+++ b/arch/arm64/configs/xilinx_defconfig
@@ -526,6 +526,7 @@ CONFIG_EDAC_VERSAL=y
 CONFIG_EDAC_XILINX_XILSEM=y
 CONFIG_RTC_CLASS=y
 CONFIG_RTC_DRV_ZYNQMP=y
+CONFIG_RTC_DRV_UEI_PDNA=y
 CONFIG_DMADEVICES=y
 CONFIG_XILINX_DMA=y
 CONFIG_XILINX_ZYNQMP_DMA=y
@@ -542,6 +543,8 @@ CONFIG_UIO_XILINX_AI_ENGINE=m
 CONFIG_VFIO=y
 CONFIG_VFIO_CDX=y
 CONFIG_STAGING=y
+CONFIG_NTL=y
+CONFIG_NTL_PHC=y
 CONFIG_XILINX_FCLK=y
 CONFIG_XLNX_SYNC=y
 CONFIG_XROE_FRAMER=m
