+    {{% else -%}}
+    in <tt>/usr/lib/systemd/system/rescue.service</tt>.
+    {{%- endif %}}
 
 rationale: |-
     This prevents attackers with physical access from trivially bypassing security
@@ -49,19 +53,30 @@ ocil_clause: 'the output is different'
 
