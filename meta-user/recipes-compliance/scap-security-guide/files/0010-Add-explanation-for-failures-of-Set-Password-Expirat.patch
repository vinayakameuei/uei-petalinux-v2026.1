From 5126a57c33791d7ec27b612d19542e0bbcd679fc Mon Sep 17 00:00:00 2001
From: Scott Ikenaga <sikenaga@ueidaq.com>
Date: Thu, 19 Sep 2024 11:35:26 -0500
Subject: [PATCH] Add explanation for failures of Set Password Expiration
 Parameters rules

---
 .../accounts_password_set_max_life_existing/rule.yml        | 6 +++++-
 .../accounts_password_set_min_life_existing/rule.yml        | 6 +++++-
 2 files changed, 10 insertions(+), 2 deletions(-)

diff --git a/linux_os/guide/system/accounts/accounts-restrictions/password_expiration/accounts_password_set_max_life_existing/rule.yml b/linux_os/guide/system/accounts/accounts-restrictions/password_expiration/accounts_password_set_max_life_existing/rule.yml
index 3f23b472a2..3b0da1201c 100644
--- a/linux_os/guide/system/accounts/accounts-restrictions/password_expiration/accounts_password_set_max_life_existing/rule.yml
+++ b/linux_os/guide/system/accounts/accounts-restrictions/password_expiration/accounts_password_set_max_life_existing/rule.yml
@@ -4,9 +4,13 @@ documentation_complete: true
 title: 'Set Existing Passwords Maximum Age'
 
 description: |-
+    {{% if product in ["openembedded"] -%}}
+    This test fails for UEI distribution for development purposes.
+    It is left to the user to configure all non-compliant accounts.
+    {{%- endif %}}
     Configure non-compliant accounts to enforce a {{{ xccdf_value("var_accounts_maximum_age_login_defs") }}}-day maximum password lifetime
     restriction by running the following command:
-    <pre>$ sudo chage -M {{{ xccdf_value("var_accounts_maximum_age_login_defs") }}} <i>USER</i></pre>
+    <pre><span style="white-space: nowrap;">$ sudo chage -M {{{ xccdf_value("var_accounts_maximum_age_login_defs") }}} <i>$USER</i></span></pre>
 
 rationale: |-
     Any password, no matter how complex, can eventually be cracked. Therefore,
diff --git a/linux_os/guide/system/accounts/accounts-restrictions/password_expiration/accounts_password_set_min_life_existing/rule.yml b/linux_os/guide/system/accounts/accounts-restrictions/password_expiration/accounts_password_set_min_life_existing/rule.yml
index da2beb59e2..ee2ff23002 100644
--- a/linux_os/guide/system/accounts/accounts-restrictions/password_expiration/accounts_password_set_min_life_existing/rule.yml
+++ b/linux_os/guide/system/accounts/accounts-restrictions/password_expiration/accounts_password_set_min_life_existing/rule.yml
@@ -4,9 +4,13 @@ documentation_complete: true
 title: 'Set Existing Passwords Minimum Age'
 
 description: |-
+    {{% if product in ["openembedded"] -%}}
+    This test fails for UEI distribution for development purposes.
+    It is left to the user to configure all non-compliant accounts.
+    {{%- endif %}}
     Configure non-compliant accounts to enforce a 24 hours/1 day minimum password
     lifetime by running the following command:
-    <pre>$ sudo chage -m 1 <i>USER</i></pre>
+    <pre>$ sudo chage -m 1 <i>$USER</i></pre>
 
 rationale: |-
     Enforcing a minimum password lifetime helps to prevent repeated password
