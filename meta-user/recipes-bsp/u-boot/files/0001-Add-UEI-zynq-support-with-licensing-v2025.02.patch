+int FindT(int a, int m, int n)
+{
+    int r;
+    int y = 1;
+
+    while (m > 0)
+    {
+        r = m % 2;
+        FastExponention(r, n, &y, &a);
+        m = m / 2;
+    }
+    return y;
+}
+
+int FastExponention(int bit, int n, int* y, int* a)
+{
+    if (bit == 1) {
+        *y = (*y * (*a)) % n;
+    }
+
+    *a = (*a) * (*a) % n;
+
+    return *a;
+}
+
+int Encryption(int value, int e, int n)
+{
+    int cipher;
+    cipher = FindT(value, e, n);
+    return cipher;
+}
+
+int Decryption(int value, int d, int n)
+{
+    int decipher;
+    decipher = FindT(value, d, n);
+    return decipher;
+}
+
+
+uint32 DecryptUint32(uint32 value) {
+    int i=0;
+    uint32 tmp = 0;
+    uint32 ret = 0;
+    //go through each byte decrypt
+    for(i=0; i<sizeof(uint32); i++)
+    {
+        tmp = (value >> (8*i)) & 0xFF;
+        ret |= ((Decryption(tmp, ENCRYPT_D, ENCRYPT_N) & 0xFF) << (8*i));
+    }
+    return ret;
+}
+
+int license_valid(PARAM* pram) {
+
+    if(check_sernum_valid(pram) != 1) {
+        printf("Invalid serial number!\n");
+        return 0;
+    }
+
+    return 1;
+}
+
+void get_option_from_license(uint32* options, PARAM* pram) {
+    uint32 tmp1;
+    char shadow_license[9];
+    int i=0;
+    const char* license = (const char*)pram->signature;
+    //clear out options
+    *options = 0;
+
+    if(strlen(license) >= 16) {
+        for(i=0; i<8; i++) {
+            //need to copy license otherwise converting to long takes in all characters
+            shadow_license[i] = license[i+8];
+        }
+        shadow_license[8] = '\0';
+        tmp1 = simple_strtol(shadow_license, NULL, 16);
+        *options = DecryptUint32(tmp1);
+    }
+}
+
+int check_sernum_valid(PARAM* pram) {
+    int ret = 1;
+    uint32 tmp1,tmp2;
+    char shadow_license[9];
+    int i=0;
+    const char* license = (const char*)pram->signature;
+
+    //validate that decrypted serial number matches encrypted
+    //check length in case license hasn't been set, needs to be at least 8
+    if(strlen(license) >= 8) {
+        for(i=0; i<8; i++) {
+            //need to copy license otherwise converting to long takes in all characters
+            shadow_license[i] = license[i];
+        }
+        shadow_license[8] = '\0';
+        tmp1 = simple_strtol(shadow_license, NULL, 16);
+        tmp2 = DecryptUint32(tmp1);
+        if((tmp2 & LICENSE_MASK) != (pram->dq.sernum & LICENSE_MASK)){
+#ifdef DEBUG_NOPRINT
+            printf("License param 0x%08x doesn't match license 0x%08x\n", pram->dq.sernum, tmp2);
+#endif
+            ret = 0;
+        }
+    }else{
+        //if license isn't set, then it can't be valid
+#ifdef DEBUG_NOPRINT
+        printf("License likely not set\n");
+#endif
+        ret = 0;
+    }
+    return ret;
+}
