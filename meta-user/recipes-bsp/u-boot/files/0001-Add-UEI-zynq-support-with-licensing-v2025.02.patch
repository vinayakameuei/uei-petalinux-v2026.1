--- /dev/null
+++ b/arch/arm/mach-zynqmp/uei-tsn.c
@@ -0,0 +1,129 @@
+/*
+* uei-tsn.c Command to Initialize TSN IP in UEI Zynq
+*
+* Maintainer: Vinayak Kulkarni <vinayak.kulkarni@ametek.com>
+*
+* Copyright (C) 2025 United Electronic Industries, Inc.
+*
+* This program is free software; you can redistribute it and/or modify
+* it under the terms of the GNU General Public License as published by
+* the Free Software Foundation; either version 2 of the License, or
+* (at your option) any later version.
+*
+* This program is distributed in the hope that it will be useful,
+* but WITHOUT ANY WARRANTY; without even the implied warranty of
+* MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+* GNU General Public License for more details.
+*
+* You should have received a copy of the GNU General Public License
+* along with this program; if not, write to the Free Software
+* Foundation, Inc., 59 Temple Place, Suite 330, Boston, MA  02111-1307  USA
+*/
+
+#include <command.h>
+#include <linux/types.h>
+#include <env.h>
+#include <hexdump.h>
+#include <malloc.h>
+#include <mapmem.h>
+#include <linux/ctype.h>
+#include <asm/cache.h>
+#include <asm/global_data.h>
+#include <linux/libfdt.h>
+#include "uei-tsn.h"
+
+DECLARE_GLOBAL_DATA_PTR;
+
+// Helper function to convert a single hex character to its integer value
+static int hex_to_int(char c) {
+    if (c >= '0' && c <= '9') {
+        return c - '0';
+    } else if (c >= 'a' && c <= 'f') {
+        return c - 'a' + 10;
+    } else if (c >= 'A' && c <= 'F') {
+        return c - 'A' + 10;
+    }
+    return -1; // Invalid hex character
+}
+
+// Correctly converts a MAC address string to two 32-bit registers
+void convert_mac_to_u32(const char *mac_str, u32 *reg1, u32 *reg2) {
+    int i, j;
+    u8 mac_bytes[6];
+
+    // The MAC string is "HH:HH:HH:HH:HH:HH" (17 characters)
+    if (strlen(mac_str) != 17) {
+        printf("TSN: Invalid MAC address string length: %s\n", mac_str);
+        return;
+    }
+
+    // Parse the MAC string into a 6-byte array
+    j = 0;
+    for (i = 0; i < 17; i += 3) {
+        int nibble1 = hex_to_int(mac_str[i]);
+        int nibble2 = hex_to_int(mac_str[i+1]);
+
+        if (nibble1 == -1 || nibble2 == -1) {
+            printf("TSN: Invalid hex character in MAC address: %s\n", mac_str);
+            return;
+        }
+        mac_bytes[j++] = (nibble1 << 4) | nibble2;
+    }
+
+    // Pack the 6 bytes into two 32-bit registers.
+    // The specific register layout depends on the hardware.
+    // This example assumes reg1 gets the first 4 bytes (MSB) and reg2 gets the last 2 bytes.
+    *reg1 = (mac_bytes[0] << 24) | (mac_bytes[1] << 16) |
+            (mac_bytes[2] << 8)  | mac_bytes[3];
+    *reg2 = (mac_bytes[4] << 16) | mac_bytes[5];
+}
+
+// if tsn node is found, this returns some offset value, otherwise it will return -1
+int is_tsn_available() {
+    return fdt_node_offset_by_compatible(gd->fdt_blob, 0, "xlnx,ntl-red-tsn-1.0");
+}
+
+// initialize and enable TSN params with most basic settings
+static int do_tsn_init(struct cmd_tbl *cmdtp, int flag, int argc, char * const argv[]) {
+    u32 val1, val2;
+    const char *mac;
+
+    // Don't do anything if tsn isn't available
+    if (is_tsn_available() == -1) {
+        debug("TSN: No compatible device tree node found for 'xlnx,ntl-red-tsn-1.0'\n");
+        return 0;
+    }
+
+    mac = env_get("ethaddr");
+    if (mac == NULL) {
+        printf("TSN: No 'ethaddr' found in U-Boot environment. Using default MAC.\n");
+        val1 = 0x33b76330;
+        val2 = 0x00007672;
+    } else {
+        convert_mac_to_u32(mac, &val1, &val2);
+        if (val1 == 0 && val2 == 0) {
+            printf("TSN: MAC address conversion failed. Using default MAC.\n");
+            val1 = 0x33b76330;
+            val2 = 0x00007672;
+        }
+    }
+
+    // Write MAC address to registers
+    *(u32*)TSN_MAC_REG1 = val1;
+    *(u32*)TSN_MAC_REG2 = val2;
+    *(u32*)TSN_MAC_CTRL_REG = TSN_MAC_SET; // set MAC is set correctly
+
+    // Configure and enable TSN
+    *(u32*)TSN_CFG_MODE_REG = 0; // set to NON mode
+    *(u32*)TSN_CFG_CTRL_REG = TSN_CFG_SET;
+    *(u32*)TSN_ENABLE_REG = TSN_ENABLE;
+
+    printf("TSN: Initialized with MAC address %s\n", mac ? mac : "default");
+
+    return 0; // Return 0 for success in U-Boot commands
+}
+
+U_BOOT_CMD(
+       tsn_init, 1, 0, do_tsn_init,
+       "UEI TSN IP Initialization", "args: [start]"
+);
