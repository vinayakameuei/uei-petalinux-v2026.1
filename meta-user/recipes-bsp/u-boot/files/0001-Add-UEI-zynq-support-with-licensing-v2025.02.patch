diff --git a/arch/arm/mach-zynqmp/dqdef.h b/arch/arm/mach-zynqmp/dqdef.h
new file mode 100644
index 00000000000..274d0426658
--- /dev/null
+++ b/arch/arm/mach-zynqmp/dqdef.h
@@ -0,0 +1,293 @@
+/* This is DaqBIOS firmware header file
+//
+// Rev. 0.1     11/28/01     AI -- initial version
+// Rev. 0.3     01/21/02     AI -- CC removed, SA added
+//
+// -------------------------------------------------------------
+// (C) UEI, Inc. 2002. All right reserved
+*/
+
+
+#ifndef _DQDEFS_H
+#define _DQDEFS_H
+
+#if defined(_WIN32) || defined(__GNUC__)
+#pragma pack(1)
+#else
+#pragma options align=packed
+#endif
+
+#define OPTION_LOGGER    0x00800400
+#define OPTION_LINUX     (1L << 20)
+#define OPTION_SIMULINK  (1L << 0)
+#define OPTION_TSN       (1L << 1)
+#define OPTION_TPM       (1L << 2)
+#define OPTION_SECURITY  (1L << 3)
+#define OPTION_IDDS      (1L << 4)
+#define OPTION_VISTAS    (1L << 5)
+#define OPTION_MODBUS    (1L << 6)
+#define OPTION_OPCUA     (1L << 8)
+
+#define LICENSE_MASK    (0x7F7F7F7F)
+
+
+
+typedef unsigned char           uint8;
+typedef unsigned short          uint16;
+typedef unsigned int            uint32;
+typedef unsigned long long      uint64;
+
+#define BUS_FREQUENCY (66000000U)
+
+#define MAX_LINE 80
+#define MAX_FILE 512
+#define MAX_FN  128
+#define MAX_ARGS 8
+
+#define MSPERIOD 10
+#define DATABUF_SIZE  (4*256*1024) /* 1MW of 32-bit DWORDs */
+
+#define STACKSZ (64*1024)
+
+#ifndef max
+#define max(x,y) (((x)>(y))?(x):(y))
+#endif
+
+#ifndef min
+#define min(x,y) (((x)<(y))?(x):(y))
+#endif
+
+#ifndef abs
+#define abs(x) (((x)>0)?(x):(-(x)))
+#endif
+
+#ifndef abs_f
+#define abs_f(x) (((x)>0)?(x):(-(x)))
+#endif
+
+#ifndef clamp
+#define clamp(x,low,high)  (((x)<(low))?(low):(((x)>(high))?(high):(x)))
+#endif
+
+#ifndef round_int
+#define round_int(x)    (((x) >= 0) ? (int)((x) + 0.5):(int)((x) - 0.5))
+#endif
+
+#define SSZ 16
+
+#define UDP_PORT        6334
+#define UDP_PORT_ASYNC  6344
+#define UDP_PORT_ASYNC_OFFS (UDP_PORT_ASYNC - UDP_PORT)
+
+
+/* --------------------------------------------------------------------
+    Channel list is a small program to control DQ FSMs
+*/
+typedef struct {
+    unsigned int  Action;       /* what to do with that entry */
+
+    uint8   dst[6];       /* IOM MAC */
+    uint32  dqCommand;    /* associated DaqBIOS command */
+    uint32  dqTStamp;     /* timestamp */
+    uint32  dqValue;      /* value is any */
+
+    uint32 *pInData;      /* pointer to input data CC<-IOM */
+    uint32  InDataSz;     /* size of input data */
+    uint32 *pOutData;     /* pointer to output data CC->IOM */
+    uint32  OutDataSz;    /* size of output data */
+    uint32  Next;         /* next entry (index) */
+
+} DQRQ;
+
+/********************************************************************
+    Parameters are stored in SA1 of the flash
+ ********************************************************************/
+// <WRITE file=powerdna.h action=add>
+
+#define DQ_DEVNAME_SIZE             (40)
+#define DQ_CLSZ                     (0x40)
+#define DQ_CFG_RECORD_SIZE          (0x2000)    /* our parameters can be as big as 8kB */
+
+#define DQ_MAX_FRAGMENTS            (8)         // maximum number of fragments for RT VMAP/DMAP = 11832 bytes UDP payload
+#define DQ_MAX_PAYLOAD_FRAG         (DQ_MAX_UDP_SIZE_100*DQ_MAX_FRAGMENTS)
+#define DQ_MIN_PAYLOAD_FRAG         (2*sizeof(uint16))  // just two control words
+
+#define CC_CSOR6 0xFFFF0030 /* op reg for CC */
+#define CC_CSBR6 0xA0000000 /* base reg for CC */
+#define IOM_CSOR 0xFFFF0000 /* op reg for IOM */
+#define IOM_CSBR 0xA0000000 /* base reg for IOM */
+
+
+
+/* --------------------------------------------------------------------
+    DQ parameters
+*/
+#if defined(__aarch64__)
+#define DQ_ETH_PORTS        3   // Three Ethernet ports for ZynqMP CPU
+#else
+#define DQ_ETH_PORTS        2   // Two Ethernet ports for IMX6SX CPU
+#endif
+
+// <WRITE file=powerdna_private.h action=add>
+
+#define DQ_COMTYPE_RAW     1
+#define DQ_COMTYPE_UDP     2
+
+#define DQ_MODE_PWRUP  1     /* device just powered-up */
+#define DQ_MODE_TEST   2     /* device is in self-test mode */
+#define DQ_MODE_READY  4     /* device completed self-initialization */
+#define DQ_MODE_INIT   8     /* device initialized from CC */
+#define DQ_MODE_OPS    16    /* device is in operation */
+
+typedef struct {
+    unsigned int mode;
+} DQ_DEVSTATE;
+
+/* runtype selection */
+#define TYPE_IOM    0x2   // IOM "slave" mode
+#define TYPE_AUTO   0x4   // move into operation mode
+#define TYPE_SA     0x8   // stand-alone mode
+#define TYPE_DL     0x10  // data logger enabled
+#define TYPE_PAC    0x20  // IOM is configured as a UEIPAC running Linux
+#define TYPE_MODBUS 0x24  // IOM is configured as a UEIModbus
+#define TYPE_SIMU   0x28  // IOM is configured as a UEISim
+#define TYPE_VXPAC  0x2C  // IOM is configured as a UEIPAC running VxWorks
+
+/* main Dq interface: Eth, UART0, IrDA or USB */
+#define PORT_ETH    0
+#define PORT_UART   1
+#define PORT_IRDA   2
+#define PORT_USB    3
+
+// Defalut port speed, 0 mean auto-negotiate
+// Settings are independent for NIC1 and NIC 2
+#define PORT_NIC1_100F      0x1
+#define PORT_NIC1_1000F     0x2
+#define PORT_NIC1_100H      0x5
+#define PORT_NIC1_1000H     0x6
+
+#define PORT_NIC2_100F      0x8
+#define PORT_NIC2_1000F     0x10
+#define PORT_NIC2_100H      0x28
+#define PORT_NIC2_1000H     0x30
+
+#define PORT_NIC1_MASK      0x7
+#define PORT_NIC2_MASK      0x38
+
+#define PORT_FORCE_RESET    0x80    // force reset on the selected type of port
+
+
+/* protocol type to support: DqTS, DqTS+DqVT, Dq->TCP/IP, Dq->USB */
+#define PROT_DQTS   0
+//#define PROT_DQVT   1
+//#define PROT_TCPIP  2
+//#define PROT_USB    3
+
+/* R/W list and its size to store in the Flash */
+#define DQRDWRLST uint32
+#define RWLSTSIZE 256
+
+/* Maximum size of signature area used to store license code for UEILogger, UEIPAC etc... */
+#define DQSIGSIZE   28
+
+// <\WRITE>
+
+#define PORT_SYNC_USE_PTP   (1<<0)
+#define PORT_SYNC_USE_NTP   (1<<1)
+
+// DQPARAM paramters - specific for IOM and located in SA1 (Flash)
+typedef struct {
+
+    /* FWCT parameters */
+    unsigned char   autorun;   /* 0 - wait for command, 1 - autorun */
+    unsigned char   runtype;   /* 0 - IOM, 1 - IOM autoinit, 2 - standalone */
+    unsigned char   portnum;   /* main Dq interface: Eth, UART0, IrDA or USB */
+    unsigned char   protocol;  /* protocol type to support: DqTS, DqTS+DqVT, Dq->TCP/IP, Dq->USB */
+
+    /* OS time settings */
+    unsigned int    cycletime; /* length of one OS time slice in us, 500us, 1, 2, 5, 10ms */
+    unsigned int    optfield;  /* option bit field */
+
+    /* Parameters of high-res timer (0) */
+    unsigned int    watchdog;  /* watchdog delay in ms; 0 - disabled */
+
+    /* Device information */
+    unsigned short  id;         /* model number */
+    unsigned short  option;     /* options */
+    unsigned int    sernum;     /* serial number */
+    unsigned int    mfgdate;    /* manufacturing date */
+    char            devname[32]; /* symbolic name of the device */
+    unsigned short  palstate;   /* state of the PAL register - LED, WD */
+    unsigned int    caldate;    /* calibration date */
+
+    /* RD/WR list for all devices */
+    DQRDWRLST       rdwrlst[RWLSTSIZE]; /* read/write list entries */
+
+} DQPARAM, *pDQPARAM;
+
+
+/* -------------------------------------------------------------------- */
+/* PID control */
+#define MAXTASKS    64
+#define MAXLOOPS    16
+#define MAXTEMP     1000
+
+
+/* Timer period info */
+#define TIMER_NETWORK_PERIOD    1000000000/0xFFFF   /* 1 sec / max timeout */
+#define TIMER_FREQ      BUS_FREQUENCY  /* 66 MHz so far :-) */
+#define TIMER_TRRREG    500       /* 15.1515... ns @ 66MHz */
+#define TIMER_PRESCALER 165
+#define TIMER_16TO1     1
+
+/* -------------------------------------------------------------------- */
+/* Structure definition for the Parameters stored in Flash */
+typedef struct {
+/* these are definitions from Motorola dBUG */
+    unsigned int    baud;       /* baud rate of the board */
+    unsigned char   mac[6];     /* ethernet hardware address (hwa) */
+    unsigned char   client[4];  /* board IP address */
+    unsigned char   server[4];  /* network download/upload host IP address */
+    unsigned char   gateway[4]; /* gateway IP address */
+    unsigned char   netmask[4]; /* netmask address */
+    unsigned char   netcfg[4];  /* network download config */
+    unsigned char   mac2[6];     /* ethernet hardware address (hwa) */
+    unsigned char   client2[4];  /* board IP address */
+    unsigned char   server2[4];  /* network download/upload host IP address */
+    unsigned char   gateway2[4]; /* gateway IP address */
+    unsigned char   netmask2[4]; /* netmask address */
+#if defined(__aarch64__)
+    unsigned char   mac3[6];     /* ethernet hardware address (hwa) */
+    unsigned char   client3[4];  /* board IP address */
+    unsigned char   server3[4];  /* network download/upload host IP address */
+    unsigned char   gateway3[4]; /* gateway IP address */
+    unsigned char   netmask3[4]; /* netmask address */
+#endif
+    char devname[DQ_DEVNAME_SIZE]; /* IOM name */
+/* these are firmware loader parameters */
+    unsigned char   fwgo;       /* 0 - boot to dBUG */
+    unsigned char   fwgo1;      /* additional control bit */
+    unsigned int    fwaddr;     /* address of user code in Flash */
+    unsigned int    fwsize;     /* size of user code */
+    unsigned int    fwcopy;     /* address to copy user code into RAM */
+    unsigned int    fwstart;    /* start address for the user code in RAM */
+    unsigned char   signature[DQSIGSIZE]; /* digital signature for secure comm (\0 is not included)*/
+    unsigned int    password;   /* password enabling bits */
+    uint16          udpport;    /* port for Dq over UDP/IP */
+/* these are DaqBIOS operation parameters */
+    DQPARAM         dq;         /* DQ parameters */
+    uint16          dummy;
+
+    /* CRC is always the last entry into PARAM structure */
+    uint32          CRC;
+} PARAM;
+
+/* -------------------------------------------------------------------- */
+#define MINIMUM_XPARAM_VERSION    1
+#define MINIMUM_XPARAM_SIZEAVAIL  2
+#define CURRENT_XPARAM_VERSION    2
+
+#define XPARAM_VERSION1_SIZE      (28)
+#define XPARAM_SIZE_MASK          (0x800-1)  /* max 2k protect against uninitiated and corruption */
+
+#endif
\ No newline at end of file
diff --git a/arch/arm/mach-zynqmp/pdna-zynqmp.c b/arch/arm/mach-zynqmp/pdna-zynqmp.c
new file mode 100644
index 00000000000..5dcc48c5469
--- /dev/null
+++ b/arch/arm/mach-zynqmp/pdna-zynqmp.c
@@ -0,0 +1,258 @@
+#include <command.h>
+#include <env.h>
+#include <init.h>
+#include <malloc.h>
+#include <dm/device.h>
+#include <dm/uclass.h>
+#include <spi.h>
+#include <spi_flash.h>
+#include <i2c.h>
+#include <timestamp.h>
+#include <version.h>
+#include <version_string.h>
+#include "si5338_regs.h"
+#include "xilinx.h"
+#include "fpga.h"
+#include "uei-zynqmp.h"
+#include "uei-tsn.h"
+#include "uei-license.h"
+
+#define QSPI0_BASE             (0x8000000)
+#define PDNA_ENV_OFFSET        (0x01e20000)
+
+//SI5338 programmed in FSBL
+#if 0
+static void i2c_program_si5338(void){
+       struct udevice *bus, *dev;
+       ofnode i2c_node;
+       int ret;
+       int count = 0;
+       uint si5338_addr = 0x70;
+       uint bus_speed = 400000; //400khz
+       uint8_t curr_val, clear_curr_val, clear_new_val, combined;
+       uint i;
+       Reg_Data curr;
+
+       //get i2c bus
+       ret = uclass_get_device_by_seq(UCLASS_I2C, 0, &bus);
+       printf("Retrieved bus of %s\n", bus->name);
+       ret = dm_i2c_probe(bus, si5338_addr, 0, &dev);
+       if( ret < 0 ){
+               printf("Failed probing for SI5338\n");
+               return;
+       }
+       printf("Retrieved device of %s\n", dev->name);
+       dm_i2c_set_bus_speed(bus, bus_speed);
+
+    //dm_i2c_reg_write(struct udevice *dev, uint offset, uint value)
+       ret = dm_i2c_reg_write(dev, 230, 0x10);
+       ret = dm_i2c_reg_write(dev, 241, 0xE5);
+
+       //loop through all registers of SI5338
+       for(i=0; i<NUM_REGS_MAX; i++){
+               curr = Reg_Store[i];
+               if(curr.Reg_Mask != 0x00){
+                       if(curr.Reg_Mask == 0xFF){
+                               //only do a write transaction
+                               //since mask is all ones
+                               ret = dm_i2c_reg_write(dev, curr.Reg_Addr, curr.Reg_Val);
+                       }else{
+                               //do a read-modify write
+                               curr_val = dm_i2c_reg_read(dev, curr.Reg_Addr);
+                               clear_curr_val = curr_val & ~curr.Reg_Mask;
+                               clear_new_val = curr.Reg_Val & curr.Reg_Mask;
+                               combined = clear_new_val | clear_curr_val;
+                               ret = dm_i2c_reg_write(dev, curr.Reg_Addr, combined);
+                       }
+               }
+       }//end iterating through SI5338 registers
+
+       // check LOS alarm for the xtal input
+       // on IN1 and IN2 (and IN3 if necessary) -
+       // change this mask if using inputs on IN4, IN5, IN6
+       printf("Waiting on input clock lock\n");
+       curr_val = dm_i2c_reg_read(dev, 218) & LOS_MASK;
+       while(curr_val !=0 && count < 30){
+               printf("Waiting on input clock lock\n");
+               curr_val = dm_i2c_reg_read(dev, 218) & LOS_MASK;
+               count++;
+       }
+       curr_val = dm_i2c_reg_read(dev, 49);
+       ret = dm_i2c_reg_write(dev, 49, curr_val & 0x7f);  //FCAL_OVRD_EN = 0
+       ret = dm_i2c_reg_write(dev, 246, 2); //soft reset
+       ret = dm_i2c_reg_write(dev, 241, 0x65); //DIS_LOL = 0
+
+       //need to sleep for ~20ms after soft reset
+       mdelay(25);
+
+       //make sure the device locked by checking PLL_LOL and SYS_CAL
+       curr_val = dm_i2c_reg_read(dev, 218) & LOCK_MASK;
+       while (curr_val != 0 && count < 30){
+               printf("Waiting for lock after soft reset\n");
+               curr_val = dm_i2c_reg_read(dev, 218) & LOCK_MASK;
+               count++;
+       }
+
+       //copy FCAL values
+       ret = dm_i2c_reg_write(dev, 45, dm_i2c_reg_read(dev, 235));
+       ret = dm_i2c_reg_write(dev, 46, dm_i2c_reg_read(dev, 236));
+       // clear bits 0 and 1 from 47 and
+       // combine with bits 0 and 1 from 237
+       curr_val = (dm_i2c_reg_read(dev, 47) & 0xFC) | (dm_i2c_reg_read(dev,237) & 3);
+       ret = dm_i2c_reg_write(dev, 47, curr_val);
+
+       curr_val = dm_i2c_reg_read(dev, 49) | 0x80;
+       ret = dm_i2c_reg_write(dev, 49, curr_val); //FCAL_OVRD_END = 1
+       ret = dm_i2c_reg_write(dev, 230, 0x0);    //OEB_ALL = 0
+
+}
+#endif
+
+static void uboot_env_set(void){
+       char enetaddr[18], enet1addr[18], enet2addr[18];
+       u8 en[6], en1[6], en2[6];
+       char ramsize[8], flashsz[8];
+       int i;
+       int ret = 0;
+       struct udevice *new;
+       static struct spi_flash *env_flash;
+       PARAM pram;
+       int unset = 1;
+       const fpga_desc *desc;
+       xilinx_desc *zynq_desc;
+       u32 options = 0;
+
+       //Get FPGA type, always dev0
+       desc = fpga_get_desc(0);
+       zynq_desc = (xilinx_desc*)desc->devdesc;
+       memset(&pram, 0, sizeof(PARAM));
+       /* speed and mode will be read from DT */
+       ret = spi_flash_probe_bus_cs(CONFIG_ENV_SPI_BUS, CONFIG_ENV_SPI_CS,
+                                    &new);
+       if (ret) {
+               env_set_default("spi_flash_probe_bus_cs() failed", 0);
+               return;
+       }
+
+       env_flash = dev_get_uclass_priv(new);
+       spi_flash_read(env_flash, PDNA_ENV_OFFSET, sizeof(PARAM), &pram);
+
+/* Set endaddr and end1addr */
+       for (i = 0; i < 6; i++) {
+               en[i] = pram.mac[i];
+               en1[i] = pram.mac2[i];
+               en2[i] = pram.mac3[i];
+               //printf("mac = %02x  mac1 = %02x  mac2 = %02x\n", en[i], en1[i], en2[i]);
+       }
+
+       //do a real check of mac address. First octets should be 00:0C:94
+       if(en[0] == 00 && en[1] == 0x0C && en[2] == 0x94) unset = 0;
+
+       if(!env_get("ethaddr")){
+               if(unset) {en[0] = 0; en[1] = 0x0c; en[2] = 0x94; en[3] = 0xf0; en[4] = 0xf0; en[5] = 0xf0;}
+               sprintf(enetaddr, "%02x:%02x:%02x:%02x:%02x:%02x",
+                       en[0], en[1], en[2], en[3], en[4], en[5]);
+               env_set("ethaddr", enetaddr);
+               //printf("Net:  ethaddr = %s\n", enetaddr);
+       }
+       if(!env_get("eth1addr")){
+               if(unset) {en1[0] = 0; en1[1] = 0x0c; en1[2] = 0x94; en1[3] = 0xf0; en1[4] = 0xf0; en1[5] = 0xf1;}
+               sprintf(enet1addr, "%02x:%02x:%02x:%02x:%02x:%02x",
+                       en1[0], en1[1], en1[2], en1[3], en1[4], en1[5]);
+               env_set("eth1addr", enet1addr);
+               //printf("Net:  eth1addr = %s\n", enet1addr);
+       }else{
+               printf("Default environment set\n");
+       }
+       if(!env_get("eth2addr")){
+               if(unset) {en2[0] = 0; en2[1] = 0x0c; en2[2] = 0x94; en2[3] = 0xf0; en2[4] = 0xf0; en2[5] = 0x13;}
+               sprintf(enet2addr, "%02x:%02x:%02x:%02x:%02x:%02x",
+                       en2[0], en2[1], en2[2], en2[3], en2[4], en2[5]);
+               env_set("eth2addr", enet2addr);
+               //printf("Net:  ethaddr = %s\n", enet2addr);
+       }
+
+       //set up the device_type if not set (This is FPGA for 3EG vs 4EG)
+       if(!env_get("device_type")){
+	       printf("Device Type: %s\n", zynq_desc->name);
+               env_set("device_type", zynq_desc->name);
+       }
+
+       //Work with the license to see if we can use TSN
+       get_option_from_license(&options, &pram);
+
+   printf("UEI License: ");
+       if(license_valid(&pram)){
+               printf("%s\n", pram.signature);
+       }else{
+               printf("Serial Number mismatch!!!\n");
+       }
+
+       //Set device tree based on FPGA type
+       if(!env_get("fdt_file")){
+               if(!strcmp(zynq_desc->name, "zu4ev")){
+                       if((is_tsn_available() != -1)) {
+                               //now check license is set correctly
+                               if (license_valid(&pram) && (options & OPTION_TSN)){
+                                       env_set("fdt_file", "system-top-4ev-tsn.dtb");
+                               }else{
+                                       printf("TSN Found but invalid License!\n");
+                                       env_set("fdt_file", "system-top-4ev.dtb");
+                               }
+                       }else {
+                               env_set("fdt_file", "system-top-4ev.dtb");
+                       }
+               }else{
+                       if((is_tsn_available() != -1)) {
+                               //now check license is set correctly
+                               if (license_valid(&pram) && (options & OPTION_TSN)){
+                                       env_set("fdt_file", "system-top-tsn.dtb");
+                               }else{
+                                       printf("TSN Found but invalid License!\n");
+                                       env_set("fdt_file", "system.dtb");
+                               }
+                       }else {
+                               env_set("fdt_file", "system.dtb");
+                       }
+               }
+       }
+
+       sprintf(ramsize, "%08lx", (unsigned long int)gd->ram_size);
+       env_set("ramsize", ramsize);
+       sprintf(flashsz, "%08lx", (unsigned long int)0x8000000); //hardcode 128MB
+       env_set("flashsz", flashsz);
+       /* set version variable */
+       env_set("ver", U_BOOT_VERSION " (" U_BOOT_DATE " - " U_BOOT_TIME ")");
+
+       spi_flash_free(env_flash);
+}
+
+
+void tsn_init(void){
+       u32 mac,val1, val2;
+       if(is_tsn_available() != -1){
+               mac = env_get("ethaddr");
+               if(mac == NULL){
+                       //set some default MAC to address this, doesn't matter what
+                       val1 = 0x33b76330;
+                       val2 = 0x00007672;
+
+               }else{
+                       convert_mac_to_u32(mac, &val1, &val2);
+               }
+               *(u32*)TSN_MAC_REG1 = val1;
+               *(u32*)TSN_MAC_REG2 = val2;
+               *(u32*)TSN_MAC_CTRL_REG = TSN_MAC_SET; //set MAC is set correctly
+               *(u32*)TSN_CFG_MODE_REG = 0; //set to NON mode
+               *(u32*)TSN_CFG_CTRL_REG = TSN_CFG_SET;
+               *(u32*)TSN_ENABLE_REG = TSN_ENABLE;
+       }
+}
+
+int pdna_zynqmp_late_init(void){
+
+    uboot_env_set();
+    //i2c_program_si5338();
+
+    return 0;
+}
