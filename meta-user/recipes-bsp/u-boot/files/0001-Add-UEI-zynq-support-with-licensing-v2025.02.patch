index 00000000000..e157b53cfee
--- /dev/null
+++ b/arch/arm/mach-zynqmp/uei-board-info.c
@@ -0,0 +1,101 @@
+/*
+ * uei-board-info.c Uboot command to get UEI Board Info
+ *
+ * Maintainer: Austyn Turner <aturner@ueidaq.com>
+ *
+ * Copyright (C) 2023 United Electronic Industries, Inc.
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 2 of the License, or
+ * (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program; if not, write to the Free Software
+ * Foundation, Inc., 59 Temple Place, Suite 330, Boston, MA  02111-1307  USA
+ */
+
+#include <errno.h>
+#include <dm.h>
+#include <command.h>
+#include <env.h>
+#include <zynqpl.h>
+#include "fpga.h"
+#include "zynqpl.h"
+
+
+#define BASE_ADDR       (0xA00E0000)
+#define DQL_CLI_LID     (0x0008)
+#define DQL_CLI_NISV    (0x000C)
+
+
+static int is_tpm_supported(void);
+static int is_tsn_supported(void);
+static int is_security_supported(void);
+static int do_get_board_info(struct cmd_tbl *cmdtp, int flag, int argc, char * const argv[]);
+
+static int is_tpm_supported(void){
+    //source from get_tpm in tpm-common.c
+    int rc;
+    struct udevice *devp;
+
+       rc = uclass_first_device_err(UCLASS_TPM, &devp);
+       if (rc) {
+               printf("Could not find TPM (ret=%d)\n", rc);
+               return 0;
+       }
+
+       return 1;
+}
+
+//For Zynq, currently TSN is only supported on 4E modules
+static int is_tsn_supported(void){
+    int ret = 0;
+    char* dev_type = env_get("device_type");
+    if(dev_type){
+        if(!strcmp(dev_type, "zu4ev") || !strcmp(dev_type, "zu4eg")){
+            ret = 1;
+        }
+    }
+    return ret;
+}
+
+static int is_security_supported(void){
+    return 1;
+}
+
+//Board info will print the following:
+//CPU Logic ID
+//CPU Logic Version
+//CPU Serial Number - stored in qspi, more work to find this
+//TPM Support
+//TSN Support
+//Security Support
+
+static int do_get_board_info(struct cmd_tbl *cmdtp, int flag, int argc, char * const argv[]){
+    int ret = 1;
+    unsigned short logicID;
+    u32 logicVer;
+
+    logicID = (unsigned short)*((u32*)(BASE_ADDR+DQL_CLI_LID));
+    logicVer = (u32)*((u32*)(BASE_ADDR+DQL_CLI_NISV)) & 0xFFFFFF;
+
+    printf("CPU Logic ID: %02x\n", logicID);
+    printf("CPU Logic Ver: %06x\n", logicVer);
+    printf("TPM Support:%d\n", is_tpm_supported());
+    printf("TSN Support: %d\n", is_tsn_supported());
+    printf("Security Support: %d\n", is_security_supported());
+
+
+    return ret;
+};
+
+U_BOOT_CMD(
+       get_board_info, 1, 0, do_get_board_info,
+       "UEI Board Info", "args: [start]"
+);
