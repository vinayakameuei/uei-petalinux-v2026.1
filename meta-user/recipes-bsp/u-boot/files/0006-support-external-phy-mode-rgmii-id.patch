From f0a3e8d80513bc874ae60d747383b000abb471e7 Mon Sep 17 00:00:00 2001
From: Vinayak <“vinayak.kulkarni@ametek.com”>
Date: Wed, 18 Feb 2026 04:58:39 -0500
Subject: [PATCH] support external phy-mode="rgmii-id"
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Signed-off-by: Vinayak <“vinayak.kulkarni@ametek.com”>
---
 drivers/net/phy/xilinx_gmii2rgmii.c | 13 -------------
 1 file changed, 13 deletions(-)

diff --git a/drivers/net/phy/xilinx_gmii2rgmii.c b/drivers/net/phy/xilinx_gmii2rgmii.c
index 16451ff01ee..5ff859ce618 100644
--- a/drivers/net/phy/xilinx_gmii2rgmii.c
+++ b/drivers/net/phy/xilinx_gmii2rgmii.c
@@ -25,11 +25,6 @@ static int xilinxgmiitorgmii_config(struct phy_device *phydev)
 
 	debug("%s\n", __func__);
 
-	if (phydev->interface != PHY_INTERFACE_MODE_GMII) {
-		printf("Incorrect interface type\n");
-		return -EINVAL;
-	}
-
 	if (!ofnode_valid(node))
 		return -EINVAL;
 
@@ -48,14 +43,6 @@ static int xilinxgmiitorgmii_config(struct phy_device *phydev)
 	}
 
 	ext_phydev->interface = ofnode_read_phy_mode(node);
-	if (ext_phydev->interface == PHY_INTERFACE_MODE_NA) {
-		ext_phydev->interface = PHY_INTERFACE_MODE_RGMII;
-	} else if (ext_phydev->interface < PHY_INTERFACE_MODE_RGMII ||
-	           ext_phydev->interface > PHY_INTERFACE_MODE_RGMII_TXID) {
-		printf("Incorrect external PHY interface type\n");
-		return -EINVAL;
-	}
-
 	ext_phydev->node = phandle.node;
 	phydev->priv = ext_phydev;
 
-- 
2.25.1

